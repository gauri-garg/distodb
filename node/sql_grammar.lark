start: statement

statement: select_stmt
         | insert_stmt
         | update_stmt
         | delete_stmt
         | create_stmt

select_stmt: SELECT columns FROM NAME [WHERE condition]

columns: STAR | col_list
col_list: NAME ("," NAME)*

insert_stmt: INSERT INTO NAME "(" col_list ")" VALUES "(" value_list ")"
value_list: value ("," value)*
value: NUMBER | ESCAPED_STRING | NAME

update_stmt: UPDATE NAME SET assignment ("," assignment)* [WHERE condition]
assignment: NAME "=" value

delete_stmt: DELETE FROM NAME [WHERE condition]

create_stmt: CREATE TABLE NAME "(" col_def ("," col_def)* ")"
col_def: NAME col_type [PRIMARY KEY]
col_type: INT | TEXT | FLOAT

condition: NAME OP value
OP: "!=" | ">=" | "<=" | ">" | "<" | "="

SELECT:  /(?i)SELECT/
INSERT:  /(?i)INSERT/
INTO:    /(?i)INTO/
VALUES:  /(?i)VALUES/
UPDATE:  /(?i)UPDATE/
SET:     /(?i)SET/
DELETE:  /(?i)DELETE/
FROM:    /(?i)FROM/
WHERE:   /(?i)WHERE/
CREATE:  /(?i)CREATE/
TABLE:   /(?i)TABLE/
PRIMARY: /(?i)PRIMARY/
KEY:     /(?i)KEY/
INT:     /(?i)INT/
TEXT:    /(?i)TEXT/
FLOAT:   /(?i)FLOAT/
STAR:    "*"

%import common.CNAME    -> NAME
%import common.NUMBER
%import common.ESCAPED_STRING
%import common.WS
%ignore WS
